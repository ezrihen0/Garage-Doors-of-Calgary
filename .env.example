# Public site URL (canonical links, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form — Resend (https://resend.com)
# Create an API key and verify the domain used in CONTACT_FROM_EMAIL.
RESEND_API_KEY=

# Verified sender on your Resend domain, e.g. "JDM Solution <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Inbox that receives form submissions (optional; defaults to the email in data/siteConfig.ts)
CONTACT_TO_EMAIL=
